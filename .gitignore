# Generated by XcodeGen — project.yml is the source of truth
*.xcodeproj/
*.xcworkspace/

# Generated by XcodeGen from project.yml
Config/*.entitlements
Config/*-Info.plist
# ...except this one, which no target generates: `make device-build` signs the
# app with it on a free Personal Team (see the Makefile). Ignored with the rest,
# it existed only on the Mac it was written on, and a fresh clone's device
# build failed for want of it.
!Config/Lift-free.entitlements

# Build artifacts
.build/
DerivedData/
*.ipa
*.dSYM.zip

# SwiftPM
.swiftpm/
Package.resolved

# macOS
.DS_Store

# The reference database is large — see SETUP.md.
# Uncomment to exclude:
# Resources/reference.db

# Raw source dumps — multi-GB, rebuild locally
data/

# Phase-1 food.db (USDA Foundation Foods + SR Legacy, ~1.5MB) is small
# enough to commit directly — see SETUP.md. Re-exclude this if a future
# phase (Open Food Facts branded data, FNDDS survey data) grows it back
# into multi-hundred-MB territory; Git LFS or a CI build step would be
# needed at that point instead.

# Claude Code worktree scratch directories
.claude/worktrees/
